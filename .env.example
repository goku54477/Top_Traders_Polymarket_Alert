# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# Required: Dome API credentials
DOME_API_KEY=your_dome_api_key_here

# Required: Telegram Bot credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: Bot Configuration
POLL_INTERVAL_MIN=5
VOLUME_THRESHOLD=100
VALUE_THRESHOLD=0.04
CACHE_TTL_MINUTES=10
MAX_MARKET_AGE_DAYS=7

# BNB Testnet Configuration (for hackathon)
BNB_RPC_URL=https://bsc-testnet.bnbchain.org
BNB_PRIVATE_KEY=your_bnb_testnet_private_key_here
BNB_CONTRACT_ADDRESS=deployed_esports_oracle_contract_address




